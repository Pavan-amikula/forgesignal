{
  "name":"ForgeSignal",
  "image":"mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "features":{"ghcr.io/devcontainers/features/node:1":{"version":"22"}},
  "forwardPorts":[8000],
  "portsAttributes":{"8000":{"label":"ForgeSignal","onAutoForward":"openPreview"}},
  "postCreateCommand":"pip install -r requirements.lock.txt && cd frontend && npm ci && npm run build",
  "postStartCommand":"python -m backend.ml",
  "customizations":{"vscode":{"extensions":["ms-python.python"]}}
}
